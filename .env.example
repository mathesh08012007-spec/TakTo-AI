# --- Required ---
GROQ_API_KEY=your_groq_api_key_here
SECRET_KEY=change_this_secret_key
DATABASE_PATH=database/companion.db

# --- Optional ---
# Check https://console.groq.com/docs/models for models your account can use.
GROQ_MODEL=openai/gpt-oss-120b
# Only used for gpt-oss models: low | medium | high (low = fastest replies)
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT=60
GROQ_MAX_TOKENS=4096
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Set to 1 when serving over HTTPS
COOKIE_SECURE=0
PORT=5000
FLASK_DEBUG=0
